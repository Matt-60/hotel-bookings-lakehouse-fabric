table fact_stay_nights
	lineageTag: b7e9970e-e85e-48d9-bfaf-f345722f876d
	sourceLineageTag: [gold].[fact_stay_nights]

	measure total_revenue =
			
			CALCULATE ( SUM ( fact_stay_nights[room_revenue] ),
			    fact_stay_nights[booking_status] <> "Cancelled" )
		formatString: #,0.00
		displayFolder: _Measures
		lineageTag: 940da2aa-2910-439c-999e-fe4b3eb971c1

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = FormatStringDefinition

		annotation PBI_FormatHint = {"isCustom":true}

	measure room_nights_sold =
			
			CALCULATE ( COUNTROWS ( fact_stay_nights ),
			    fact_stay_nights[booking_status] <> "Cancelled" )
		formatString: 0
		displayFolder: _Measures
		lineageTag: 0aaa5b77-6bf5-466f-8c6d-90dbdf82c903

		changedProperty = DisplayFolder

		changedProperty = Name

	measure total_bookings = ```
			
			CALCULATE ( COUNTROWS ( fact_stay_nights ), fact_stay_nights[is_first_night] = TRUE () )
			
			```
		formatString: 0
		displayFolder: _Measures
		lineageTag: 32ed382c-a244-4c73-9a04-66d89bddb354

		changedProperty = DisplayFolder

		changedProperty = Name

	measure avg_nights =
			
			AVERAGEX ( VALUES ( fact_stay_nights[booking_id] ),
			    CALCULATE ( MAX ( fact_stay_nights[nights_stayed] ) ) )
		formatString: 0.0
		displayFolder: _Measures
		lineageTag: f179b966-c94c-4739-9c90-9ad1634f3d07

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	measure avg_review_rating =
			
			AVERAGEX ( VALUES ( fact_stay_nights[booking_id] ),
			    CALCULATE ( MAX ( fact_stay_nights[review_rating] ) ) )
		formatString: 0.0
		displayFolder: _Measures
		lineageTag: 146349a1-0477-4add-b2e1-ab5ede2de722

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	measure cancellation_rate =
			
			VAR _cancelled =
			    CALCULATE ( [total_bookings], fact_stay_nights[booking_status] = "Cancelled" )
			VAR _all =
			    CALCULATE ( [total_bookings], REMOVEFILTERS ( fact_stay_nights[booking_status] ) )
			RETURN DIVIDE ( _cancelled, _all, 0 )
		formatString: 0%;-0%;0%
		displayFolder: _Measures
		lineageTag: 034811bb-5ade-46ea-9232-87263aebd407

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure ADR = DIVIDE ( [total_revenue], [room_nights_sold] )
		formatString: #,0.00
		displayFolder: _Measures
		lineageTag: 4ea5929c-efad-4bf7-bdc6-8f6d997a79c0

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = FormatStringDefinition

		annotation PBI_FormatHint = {"isCustom":true}

	measure occupancy =
			
			DIVIDE ( [room_nights_sold], COUNTROWS ( dim_rooms ) * COUNTROWS ( dim_date ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: _Measures
		lineageTag: 6dbee8d4-46a8-4b47-9133-64989f4aae4c

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure RevPAR = DIVIDE ( [total_revenue], COUNTROWS ( dim_rooms ) * COUNTROWS ( dim_date ) )
		formatString: #,0.00
		displayFolder: _Measures
		lineageTag: 50832b2a-449a-4752-a376-f8fd339bd9d1

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

